# target to build an object file
src/main.cpp.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/matcha_backend.dir/build.make CMakeFiles/matcha_backend.dir/src/main.cpp.o
.PHONY : src/main.cpp.o

