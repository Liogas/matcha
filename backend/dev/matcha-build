#!/bin/sh
# Compile le backend dans /app/build (volume Docker, garde les .o entre deux lancements).
# Usage : matcha-build            -> uniquement l'executable
#         matcha-build all        -> executable + tests
set -eu
cd /app

cmake -S . -B build \
	-DCMAKE_BUILD_TYPE="${CMAKE_BUILD_TYPE:-Debug}" \
	-DCMAKE_TOOLCHAIN_FILE=/opt/vcpkg/scripts/buildsystems/vcpkg.cmake \
	-DVCPKG_INSTALLED_DIR="$VCPKG_INSTALLED_DIR" \
	-DVCPKG_MANIFEST_INSTALL=OFF \
	> /dev/null

if [ "${1:-}" = "all" ]; then
	cmake --build build --parallel "$(nproc)"
else
	cmake --build build --target matcha_backend --parallel "$(nproc)"
fi
