# Copie automatique vers .env (non versionne) et generation des secrets
# manquants dans ./secrets (non versionne) : `make secrets`.
# Aucun mot de passe ni cle ne doit apparaitre ici : seulement des chemins.

POSTGRES_DB=matcha
POSTGRES_USER=matcha
DB_PASSWORD_FILE=./secrets/db-password

JWT_ISSUER=matcha-backend
JWT_AUDIENCE=matcha-frontend
JWT_JWKS_URL=http://backend:18080/.well-known/jwks.json
JWT_ALLOW_INSECURE_HTTP=true
JWT_KEY_ID=matcha-dev-key-1
JWT_PRIVATE_KEY_FILE=./secrets/jwt-private.pem

REDIS_PASSWORD_FILE=./secrets/redis-password
